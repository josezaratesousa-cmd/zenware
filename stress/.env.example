# Copiar a una ruta FUERA del repositorio, chmod 600, y apuntar STRESS_ENV_FILE a ella:
#   cp .env.example /home/usuario/stress.env && chmod 600 /home/usuario/stress.env
#   STRESS_ENV_FILE=/home/usuario/stress.env ./stress

# API de Stamping (obligatorio)
STAMPING_BASE_URL=https://api.stamping.io
STAMPING_TOKEN=

# Proceso con el que se marcan las actas de prueba (A-Z, 0-9 y guion, máximo 12)
PROCESS_CODE=ZW-TEST
PROCESS_NAME=Prueba de estres Zenware
# Primer numero de mesa; la mesa n es STATION_BASE + n
STATION_BASE=1000000

# Interfaz web. Por defecto solo escucha en localhost.
# Si se expone en otra direccion, STRESS_UI_PASSWORD es obligatoria.
LISTEN_ADDR=127.0.0.1:8090
STRESS_UI_PASSWORD=

# Enlace al visor (opcional: sin estas tres, la interfaz no muestra enlaces)
VISOR_URL=
CUSTODY_PATH=
CODE_CIPHER_KEY=

# Donde se guardan los reportes de cada ejecucion (resumen y CSV)
RUNS_DIR=./runs
